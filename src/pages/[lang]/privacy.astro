---
import LegalPage from "../../components/LegalPage.astro";
import { translatedLocales, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return translatedLocales.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<LegalPage {locale} page="privacy" />
