---
import SiteLayout from "../layouts/SiteLayout.astro";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const principles = [
  {
    number: "01",
    title: "Understands your day",
    copy: "Calan brings together your schedule, tasks, messages, location, and the world around you.",
  },
  {
    number: "02",
    title: "Notices what changed",
    copy: "It keeps an eye on the details that can affect your plans, from traffic to weather to a shifted meeting.",
  },
  {
    number: "03",
    title: "Speaks up with purpose",
    copy: "You receive one clear, timely suggestion only when there is something genuinely useful to know.",
  },
];

const notificationExamples = [
  {
    title: "Leave in 10 minutes",
    copy: "Your 11:00 meeting is 25 minutes away. Avoid the highway, and bring an umbrella for the trip home.",
    sourceCount: "4 sources combined",
    sources: "Calendar / Location / Traffic / Weather",
    signals: [
      { source: "Calendar", value: "Meeting at 11:00", selected: true },
      { source: "News", value: "Morning digest", selected: false },
      { source: "Location", value: "Still at home", selected: true },
      { source: "Messages", value: "Lunch on Friday?", selected: false },
      { source: "Traffic", value: "Heavy on A6", selected: true },
      { source: "Tasks", value: "File expenses", selected: false },
      { source: "Weather", value: "Rain at 5:00", selected: true },
      { source: "Home", value: "Laundry is done", selected: false },
    ],
  },
  {
    title: "Your briefing is ready",
    copy: "Maya shared the final numbers. You have a 20-minute focus block before tomorrow's review.",
    sourceCount: "4 sources combined",
    sources: "Calendar / Email / Docs / Tasks",
    signals: [
      { source: "Calendar", value: "Review tomorrow", selected: true },
      { source: "Weather", value: "Clear this afternoon", selected: false },
      { source: "Email", value: "Maya replied", selected: true },
      { source: "Messages", value: "Lunch on Friday?", selected: false },
      { source: "Docs", value: "Final figures shared", selected: true },
      { source: "Maps", value: "Usual route", selected: false },
      { source: "Tasks", value: "Briefing due", selected: true },
      { source: "Home", value: "Laundry is done", selected: false },
    ],
  },
  {
    title: "Take the 18:20 train",
    copy: "Your usual service is delayed. The next train gets you home 14 minutes sooner.",
    sourceCount: "4 sources combined",
    sources: "Calendar / Location / Transit / Maps",
    signals: [
      { source: "Calendar", value: "Dinner at 19:30", selected: true },
      { source: "News", value: "Evening headlines", selected: false },
      { source: "Location", value: "Leaving the office", selected: true },
      { source: "Messages", value: "Weekend plans?", selected: false },
      { source: "Transit", value: "Usual train delayed", selected: true },
      { source: "Tasks", value: "File expenses", selected: false },
      { source: "Maps", value: "18:20 is faster", selected: true },
      { source: "Weather", value: "Clear evening", selected: false },
    ],
  },
];

const signalPositions = [
  "signal-calendar",
  "signal-digest",
  "signal-location",
  "signal-message",
  "signal-traffic",
  "signal-task",
  "signal-weather",
  "signal-routine",
];
---

<SiteLayout>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Calan",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "iOS",
    description: "A personal AI assistant that delivers the right notification at the right time.",
  })} />

  <header class="site-header shell">
    <a class="wordmark" href="#top" aria-label="Calan home">Calan</a>
    <nav aria-label="Primary navigation">
      <a href="#how-it-works">How it works</a>
      <a href="#control">Your control</a>
    </nav>
    <a class="header-cta" href="#waitlist">Join the waitlist <span aria-hidden="true">&rarr;</span></a>
  </header>

  <main id="top">
    <section class="hero shell" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span></span>Your personal AI assistant</p>
        <h1 id="hero-title">The right notification<br /><em>at the right time.</em></h1>
        <p class="hero-intro">
          Calan understands the context around your day and lets you know what matters,
          before it becomes urgent.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href="#waitlist">Join the waitlist <span aria-hidden="true">&rarr;</span></a>
          <p>Coming first to iPhone</p>
        </div>
      </div>

      <div class="context-demo" data-scenario="0" aria-label="Calan filters many incoming signals, selects the relevant context, and turns it into one useful notification">
        <div class="demo-caption">
          <span class="demo-status"><i></i>Live context / 8 signals</span>
          <span>10:50 AM</span>
        </div>

        <div class="signal-field">
        <svg class="signal-map" viewBox="0 0 600 500" preserveAspectRatio="none" aria-hidden="true">
          <path class="signal-path signal-path-selected" d="M102 112 C102 244 232 250 300 388" />
          <path class="signal-path signal-path-selected" d="M505 176 C518 294 388 278 300 388" />
          <path class="signal-path signal-path-selected" d="M113 274 C164 394 246 326 300 388" />
          <path class="signal-path signal-path-selected" d="M505 320 C430 414 365 332 300 388" />
          <path class="signal-path signal-path-later" d="M490 98 C452 135 430 163 413 203" />
          <path class="signal-path signal-path-later" d="M94 196 C127 222 150 239 174 253" />
          <path class="signal-path signal-path-later" d="M500 250 C468 270 445 284 418 296" />
          <path class="signal-path signal-path-later" d="M92 334 C132 350 164 360 196 364" />
          <path class="signal-path signal-flow" d="M102 112 C102 244 232 250 300 388" />
          <path class="signal-path signal-flow" d="M505 176 C518 294 388 278 300 388" />
          <path class="signal-path signal-flow" d="M113 274 C164 394 246 326 300 388" />
          <path class="signal-path signal-flow" d="M505 320 C430 414 365 332 300 388" />
          <path class="signal-path signal-output" d="M300 373 C300 395 300 414 300 432" />
        </svg>

        {notificationExamples[0].signals.map((signal, index) => (
          <div
            class:list={[
              "signal",
              signalPositions[index],
              signal.selected ? "signal-selected" : "signal-noise",
            ]}
            data-signal
          >
            <span class="signal-icon" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <span class="signal-copy">
              <small data-signal-source>{signal.source}</small>
              <span data-signal-value>{signal.value}</span>
            </span>
            <span class="signal-state" data-signal-state>{signal.selected ? "now" : "later"}</span>
          </div>
        ))}

        </div>

        <div class="signal-selector" aria-hidden="true">
          <span class="selector-ring"></span>
          <span class="selector-kicker"><i></i>Calan / filter</span>
          <strong>Relevant now</strong>
          <small><b>04</b> of 08 signals selected</small>
        </div>

        <div class="notification-stage" aria-label="Examples of useful Calan notifications">
          {notificationExamples.map((example, index) => (
            <article
              class:list={["notification", { "is-active": index === 0 }]}
              data-notification
              data-signals={JSON.stringify(example.signals)}
              aria-hidden={index === 0 ? "false" : "true"}
            >
              <div class="notification-topline">
                <span class="notification-mark">C</span>
                <span>CALAN</span>
                <time>now</time>
              </div>
              <h2>{example.title}</h2>
              <p>{example.copy}</p>
              <div class="notification-context">
                <span>{example.sourceCount}</span>
                <span>{example.sources}</span>
                <span>{String(index + 1).padStart(2, "0")} / {String(notificationExamples.length).padStart(2, "0")}</span>
              </div>
            </article>
          ))}
        </div>
      </div>

      <a class="scroll-cue" href="#idea">
        <span aria-hidden="true"></span>
        See how Calan thinks
      </a>
    </section>

    <section class="statement shell reveal" id="idea" aria-labelledby="statement-title">
      <p class="section-label">A different kind of assistant</p>
      <h2 id="statement-title">
        Your day doesn't happen<br />in one app. <em>Neither should<br />your assistant.</em>
      </h2>
      <div class="statement-copy">
        <p>
          Most tools wait for you to ask the right question. Calan connects the signals
          around your day, understands what they mean together, and helps before you have to ask.
        </p>
        <p class="quiet-line">Helpful when it matters. Quiet when it doesn't.</p>
      </div>
    </section>

    <section class="principles shell" id="how-it-works" aria-labelledby="principles-title">
      <div class="section-heading reveal">
        <p class="section-label">How it works</p>
        <h2 id="principles-title">More context.<br /><em>Fewer interruptions.</em></h2>
      </div>
      <div class="principle-list">
        {principles.map((principle) => (
          <article class="principle reveal">
            <span class="principle-number">{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="day-section" aria-labelledby="day-title">
      <div class="day-inner shell">
        <div class="day-heading reveal">
          <p class="section-label section-label-light">There when it counts</p>
          <h2 id="day-title">A step ahead,<br /><em>all day.</em></h2>
          <p>Calan turns small signals into useful moments, without turning your attention into another inbox.</p>
        </div>

        <ol class="day-timeline" aria-label="Examples of Calan helping throughout the day">
          <li class="reveal">
            <time>08:40</time>
            <div>
              <span>Before your first meeting</span>
              <p>Your 9:00 moved online. You have time to finish breakfast.</p>
            </div>
          </li>
          <li class="featured reveal">
            <time>10:50</time>
            <div>
              <span>Before you need to leave</span>
              <p>Leave in 10 minutes. Take the river route and bring an umbrella.</p>
            </div>
          </li>
          <li class="reveal">
            <time>15:25</time>
            <div>
              <span>When a follow-up matters</span>
              <p>Sam replied with the figures you need for tomorrow's review.</p>
            </div>
          </li>
          <li class="reveal">
            <time>18:10</time>
            <div>
              <span>When plans change</span>
              <p>Your usual train is delayed. The next bus gets you home sooner.</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="control shell reveal" id="control" aria-labelledby="control-title">
      <div class="control-visual" aria-hidden="true">
        <svg class="control-links" viewBox="0 0 560 560" preserveAspectRatio="none">
          <line x1="280" y1="280" x2="280" y2="34" />
          <line x1="280" y1="280" x2="470" y2="116" />
          <line x1="280" y1="280" x2="90" y2="116" />
          <line x1="280" y1="280" x2="530" y2="280" />
          <line x1="280" y1="280" x2="30" y2="280" />
          <line x1="280" y1="280" x2="470" y2="448" />
          <line x1="280" y1="280" x2="90" y2="448" />
          <line x1="280" y1="280" x2="280" y2="526" />
        </svg>
        <span class="control-circle control-circle-outer"></span>
        <span class="control-circle control-circle-middle"></span>
        <span class="control-circle control-circle-inner"></span>
        <span class="control-core">You</span>
        <span class="permission permission-calendar"><b>01</b>Calendar <i>On</i></span>
        <span class="permission permission-email"><b>02</b>Email <i>Connected</i></span>
        <span class="permission permission-whatsapp"><b>03</b>WhatsApp <i>Ask first</i></span>
        <span class="permission permission-weather"><b>04</b>Weather <i>On</i></span>
        <span class="permission permission-messages"><b>05</b>Messages <i>Off</i></span>
        <span class="permission permission-maps"><b>06</b>Maps <i>While using</i></span>
        <span class="permission permission-tasks"><b>07</b>Tasks <i>On</i></span>
        <span class="permission permission-docs"><b>08</b>Docs <i>Connected</i></span>
      </div>
      <div class="control-copy">
        <p class="section-label">You decide what Calan knows</p>
        <h2 id="control-title">Intelligence with<br /><em>you in control.</em></h2>
        <p>
          Calan is designed around explicit permissions. You choose which sources to connect,
          see what is being used, and can change your mind at any time.
        </p>
        <a href="/privacy/">Our approach to privacy <span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>

    <section class="waitlist" id="waitlist" aria-labelledby="waitlist-title">
      <div class="waitlist-inner shell reveal">
        <p class="section-label section-label-light">Coming first to iPhone</p>
        <h2 id="waitlist-title">Make room for<br /><em>what matters.</em></h2>
        <p class="waitlist-copy">Join the waitlist for thoughtful updates and early access to Calan.</p>

        <form class="waitlist-form" data-waitlist-form novalidate>
          <label for="email">Email address</label>
          <div class="form-row">
            <input id="email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required />
            <button type="submit">Join the waitlist <span aria-hidden="true">&rarr;</span></button>
          </div>
          {turnstileSiteKey && (
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" data-size="flexible"></div>
          )}
          <p class="form-note">No noise. Just meaningful updates. Unsubscribe anytime.</p>
          <p class="form-status" data-form-status aria-live="polite"></p>
        </form>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <a class="wordmark wordmark-light" href="#top">Calan</a>
      <p>The right notification at the right time.</p>
      <div class="footer-links">
        <a href="/privacy/">Privacy</a>
        <a href="/terms/">Terms</a>
        <span>&copy; {new Date().getFullYear()} Calan</span>
      </div>
    </div>
  </footer>

  {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

  <script>
    const revealElements = document.querySelectorAll(".reveal");

    if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("has-reveal");
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.14 });

      revealElements.forEach((element) => observer.observe(element));
    }

    const contextDemo = document.querySelector<HTMLElement>(".context-demo");
    const notificationStage = contextDemo?.querySelector<HTMLElement>(".notification-stage");
    const notifications = Array.from(contextDemo?.querySelectorAll<HTMLElement>("[data-notification]") ?? []);
    const signalElements = Array.from(contextDemo?.querySelectorAll<HTMLElement>("[data-signal]") ?? []);
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let replayTimer: number | undefined;
    let activeNotification = 0;
    const readingTime = 12000;
    const layoutTransitionTime = 1400;

    const updateSignals = (notification: HTMLElement) => {
      const scenarioSignals = JSON.parse(notification.dataset.signals ?? "[]") as Array<{
        source: string;
        value: string;
        selected: boolean;
      }>;

      signalElements.forEach((signalElement, index) => {
        const signal = scenarioSignals[index];
        if (!signal) return;

        const source = signalElement.querySelector<HTMLElement>("[data-signal-source]");
        const value = signalElement.querySelector<HTMLElement>("[data-signal-value]");
        const state = signalElement.querySelector<HTMLElement>("[data-signal-state]");

        if (source) source.textContent = signal.source;
        if (value) value.textContent = signal.value;
        if (state) state.textContent = signal.selected ? "now" : "later";
        signalElement.classList.toggle("signal-selected", signal.selected);
        signalElement.classList.toggle("signal-noise", !signal.selected);
      });
    };

    const showNotification = (index: number) => {
      activeNotification = index;
      if (contextDemo) contextDemo.dataset.scenario = String(index);
      notifications.forEach((notification, notificationIndex) => {
        const isActive = notificationIndex === index;
        notification.classList.toggle("is-active", isActive);
        notification.setAttribute("aria-hidden", String(!isActive));
      });
      const activeExample = notifications[index];
      if (activeExample) updateSignals(activeExample);
    };

    const replayDemo = () => {
      if (!contextDemo || reducedMotion.matches) return;
      showNotification(0);
      contextDemo.classList.add("is-resetting");
      void contextDemo.offsetWidth;
      contextDemo.classList.remove("is-resetting");
    };

    const advanceNotification = () => {
      if (reducedMotion.matches) return;

      if (activeNotification < notifications.length - 1) {
        contextDemo?.classList.add("is-switching-scenario");
        replayTimer = window.setTimeout(() => {
          showNotification(activeNotification + 1);
          contextDemo?.classList.remove("is-switching-scenario");
          replayTimer = window.setTimeout(advanceNotification, readingTime + layoutTransitionTime);
        }, 360);
        return;
      }

      replayDemo();
    };

    notificationStage?.addEventListener("animationend", (event) => {
      if (event.animationName !== "notification-in" || reducedMotion.matches) return;
      window.clearTimeout(replayTimer);
      replayTimer = window.setTimeout(advanceNotification, readingTime);
    });

    reducedMotion.addEventListener("change", (event) => {
      window.clearTimeout(replayTimer);
      contextDemo?.classList.remove("is-switching-scenario");
      showNotification(0);
      if (!event.matches) replayDemo();
    });

    const form = document.querySelector<HTMLFormElement>("[data-waitlist-form]");
    const status = document.querySelector<HTMLElement>("[data-form-status]");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!status) return;

      const emailInput = form.elements.namedItem("email") as HTMLInputElement;
      const submitButton = form.querySelector<HTMLButtonElement>("button[type='submit']");

      if (!emailInput.validity.valid) {
        status.textContent = "Enter a valid email address.";
        status.dataset.state = "error";
        emailInput.focus();
        return;
      }

      const turnstileInput = form.querySelector<HTMLInputElement>("[name='cf-turnstile-response']");
      submitButton?.setAttribute("disabled", "");
      status.textContent = "Joining...";
      status.dataset.state = "loading";

      try {
        const response = await fetch("/api/waitlist", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            email: emailInput.value,
            turnstileToken: turnstileInput?.value ?? "",
          }),
        });
        const result = await response.json() as { message?: string };

        if (!response.ok) throw new Error(result.message || "Something went wrong. Please try again.");

        form.reset();
        status.textContent = result.message || "You're on the list. We'll be in touch.";
        status.dataset.state = "success";
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : "Something went wrong. Please try again.";
        status.dataset.state = "error";
      } finally {
        submitButton?.removeAttribute("disabled");
      }
    });
  </script>
</SiteLayout>
